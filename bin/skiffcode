#!/usr/bin/env bash
# skiffcode — repos, worktrees and Claude Code sessions in one app window.
#
#   skiffcode [dir]          start SkiffCode (if needed) and open it; with <dir>, add that repo and show it
#   skiffcode --tab [dir]    open in a normal browser tab instead of an app window
#   skiffcode status | stop | restart | logs | url
#   skiffcode new <repo> <branch> [-b|--base <ref>] [--name <session>] [--prompt <text>|-]
#                            worktree for <branch> (created if needed, from <ref>, e.g. origin/develop)
#                            + a Claude session in it
#   skiffcode claude <worktree> [--name <session>] [--prompt <text>|-]   new Claude session there
#   skiffcode list [--json]  repos, worktrees and sessions
#   skiffcode update         get the latest version from GitHub and reinstall (sessions keep running)
#   skiffcode version
#
# The server runs in WSL/Linux/macOS next to your repos and only listens on 127.0.0.1.
set -euo pipefail

SKIFFCODE_HOME="${SKIFFCODE_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/skiffcode}"
APP="${SKIFFCODE_APP:-$SKIFFCODE_HOME/app}"
PORT="${SKIFFCODE_PORT:-3417}"
LOG="$SKIFFCODE_HOME/server.log"
REPO="${SKIFFCODE_REPO:-https://github.com/ykim-xr/skiffcode.git}"
export SKIFFCODE_HOME SKIFFCODE_PORT="$PORT"

die() { echo "skiffcode: $*" >&2; exit 1; }

update() {
  command -v git >/dev/null || die "git is required"
  local src="$SKIFFCODE_HOME/src"
  if [[ -d "$src/.git" ]]; then
    echo "Updating from $(git -C "$src" remote get-url origin) …"
    git -C "$src" fetch --depth 1 origin main && git -C "$src" reset --hard -q FETCH_HEAD || die "couldn't update $src"
  else
    rm -rf "$src"
    git clone -q --depth 1 "$REPO" "$src" || die "couldn't download $REPO"
  fi
  exec bash "$src/install.sh"
}
case "${1:-}" in
  update) update ;;
  version) node -p "require('$APP/package.json').version" 2>/dev/null || echo "not installed"; exit 0 ;;
esac

[[ -f "$APP/server/main.js" ]] || die "not installed — run: skiffcode update  (or ./install.sh from a copy of the repo)"
command -v node >/dev/null || die "Node.js 18+ is required (see the README)"
(umask 077; mkdir -p "$SKIFFCODE_HOME/inbox")

token() { cat "$SKIFFCODE_HOME/token" 2>/dev/null; }

# Ask the server whether it's SkiffCode and whether a window is open. Prints JSON or nothing.
status_json() {
  local t; t="$(token)"; [[ -n "$t" ]] || return 1
  # The token goes in the environment: other users can read a command line (ps), not an environment.
  SKIFFCODE_TOKEN="$t" node -e '
    fetch(`http://127.0.0.1:${process.argv[1]}/api/status`, { headers: { "x-skiffcode-token": process.env.SKIFFCODE_TOKEN }, signal: AbortSignal.timeout(2000) })
      .then(r => (r.ok ? r.text() : "")).then(t => process.stdout.write(t)).catch(() => {})
      .finally(() => process.exit()); // an aborted fetch can keep node alive for 10s on a port that stays silent
  ' "$PORT"
}
# Time-limited: under WSL mirrored networking a closed loopback port can stay silent, and a plain connect then waits about 2 minutes.
# macOS has no `timeout`: the plain probe is fine there (loopback refuses at once).
port_busy() {
  local t=""
  if command -v timeout >/dev/null; then t="timeout --foreground 1"; fi
  $t bash -c 'exec 3<>"/dev/tcp/127.0.0.1/$0"' "$PORT" 2>/dev/null
}
port_owner() {
  if command -v ss >/dev/null; then
    ss -ltnpH "sport = :$PORT" 2>/dev/null | grep -o 'users:(([^)]*' | sed 's/users:((//' | head -1
  elif command -v lsof >/dev/null; then
    lsof -nP -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | awk 'NR == 2 { printf "\"%s\",pid=%s\n", $1, $2; f = 1 } END { exit !f }'
  else
    return 1
  fi
}
running() { [[ -n "$(status_json 2>/dev/null || true)" ]]; }

start() {
  [[ -t 2 ]] && echo "Opening SkiffCode …" >&2
  running && return 0
  if port_busy; then
    die "port $PORT is already used by another program ($(port_owner || echo unknown)).
Stop it, or run SkiffCode on another port:  SKIFFCODE_PORT=3418 skiffcode"
  fi
  echo "Starting SkiffCode on http://localhost:$PORT …" >&2
  # The last run's log stays as server.log.1 (it may say why that server stopped).
  if [[ -s "$LOG" ]]; then mv -f "$LOG" "$LOG.1"; fi
  # A private log without changing the server's umask (its terminals inherit that).
  (umask 077; : >>"$LOG"); chmod 600 "$LOG"
  # Always from the home folder: started from a Windows folder (/mnt/c/…, slow in WSL) the server can hang or fail.
  # SKIFFCODE_USAGE_URL is for tests only: a shell's leftover value must never get a real token.
  if command -v setsid >/dev/null; then
    ( cd "$HOME" 2>/dev/null || cd /; exec setsid nohup env -u SKIFFCODE_USAGE_URL node "$APP/server/main.js" >>"$LOG" 2>&1 </dev/null ) &
  else
    # macOS has no setsid, and nohup doesn't detach: Node starts the server in a session of its own,
    # so Ctrl-C here and prompts that read the terminal (ssh) can't reach or stop it.
    ( cd "$HOME" 2>/dev/null || cd /; exec env -u SKIFFCODE_USAGE_URL node -e 'require("child_process").spawn(process.execPath, [process.argv[1]], { detached: true, stdio: "inherit" }).unref()' "$APP/server/main.js" >>"$LOG" 2>&1 </dev/null ) &
  fi
  for _ in $(seq 1 150); do
    running && return 0
    sleep 0.1
  done
  die "server didn't start — see $LOG"

}

# Stop the server and wait until it has really exited and let go of the port (sessions keep running).
# Without the wait, a restart could find the old server still answering, think it was already up,
# and leave nothing running once the old one finished exiting.
# Only a pid SkiffCode itself reports, or one whose command line is a SkiffCode server: a stale
# server.pid may name an unrelated process by now.
# Without /proc (macOS) the command line comes from ps; a failed or unmatched lookup counts as "not ours".
is_server() {
  if [[ -d /proc/self ]]; then
    tr '\0' '\n' <"/proc/$1/cmdline" 2>/dev/null | grep -Eq '(^|/)server/main\.js$'
  else
    /bin/ps -ww -o command= -p "$1" 2>/dev/null | grep -Eq '(^|[ /])server/main\.js( |$)'
  fi
}
server_pid() {
  local pid
  pid="$(status_json 2>/dev/null | grep -o '"pid":[0-9]*' | cut -d: -f2 || true)"
  if [[ -z "$pid" ]]; then
    pid="$(cat "$SKIFFCODE_HOME/server.pid" 2>/dev/null || true)"
    [[ "$pid" =~ ^[0-9]+$ ]] && is_server "$pid" || pid=""
  fi
  printf '%s' "$pid"
}

stop() {
  local pid; pid="$(server_pid)"
  if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then echo "not running"; return 0; fi
  kill "$pid" 2>/dev/null || true
  local i
  for i in $(seq 1 100); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
  if kill -0 "$pid" 2>/dev/null; then kill -9 "$pid" 2>/dev/null || true; sleep 0.2; fi
  for i in $(seq 1 50); do port_busy || break; sleep 0.1; done
  echo "stopped (sessions keep running)"
}

urlencode() {
  # Bytes come from od: bash 3.2 (macOS) can't be trusted to split a string into bytes.
  local out="" b c
  for b in $(printf '%s' "$1" | od -An -v -tx1 | tr a-f A-F); do
    case "$b" in
      2[DEF]|3[0-9]|4[1-9A-F]|5[0-9AF]|6[1-9A-F]|7[0-9AE]) printf -v c "\\x$b"; out+="$c" ;;
      *) out+="%$b" ;;
    esac
  done
  printf '%s' "$out"
}

url() {
  local u="http://localhost:$PORT/?tkn=$(token)"
  [[ -n "${1:-}" ]] && u+="&folder=$(urlencode "$1")"
  printf '%s' "$u"
}

# Windows PowerShell from WSL: never let it wait on the terminal for input, and never for long.
# --foreground: WSL suspends Windows programs started outside the terminal's foreground (plain `timeout`).
winps() { timeout --foreground 30 powershell.exe -NoProfile -NonInteractive -Command "$1" </dev/null >/dev/null 2>&1; }

open_url() { # url, app(1/0)
  local u="$1" app="$2"
  if grep -qi microsoft /proc/version 2>/dev/null && command -v powershell.exe >/dev/null; then
    if ((app)); then
      # Edge is on every Windows; an --app window has no tabs or address bar.
      winps "Start-Process msedge -ArgumentList '--app=$u'" || winps "Start-Process '$u'"
    else
      winps "Start-Process '$u'"
    fi
  elif [[ "$(uname -s)" == Darwin ]]; then
    local a
    if ((app)); then
      # open's exit status tells whether the app exists; -n starts a new instance so --app is honoured.
      for a in "Google Chrome" "Microsoft Edge" "Brave Browser" "Chromium"; do
        open -na "$a" --args --app="$u" >/dev/null 2>&1 && return 0
      done
    fi
    open "$u" >/dev/null 2>&1 || echo "Open this in your browser: $u"
  elif command -v xdg-open >/dev/null; then
    local b
    if ((app)) && b="$(command -v google-chrome || command -v chromium || command -v microsoft-edge || true)" && [[ -n "$b" ]]; then
      "$b" --app="$u" >/dev/null 2>&1 &
    else xdg-open "$u" >/dev/null 2>&1 &
    fi
  else
    echo "Open this in your browser: $u"
  fi
}

# ---- commands for scripts and Claude skills: new / claude / list
cli() {
  local cmd="$1"; shift
  local -a pos=()
  local base="" name="" prompt="" claude=1 show=1 json=0
  while (($#)); do
    case "$1" in -b|--base|-n|--name|-p|--prompt) (($# >= 2)) || die "$1 needs a value" ;; esac
    case "$1" in
      -b|--base) base="$2"; shift 2 ;;
      --base=*) base="${1#*=}"; shift ;;
      -n|--name) name="$2"; shift 2 ;;
      --name=*) name="${1#*=}"; shift ;;
      -p|--prompt) prompt="$2"; shift 2 ;;
      --prompt=*) prompt="${1#*=}"; shift ;;
      --no-claude) claude=0; shift ;;
      --no-show) show=0; shift ;;
      --json) json=1; shift ;;
      -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
      -*) die "unknown option: $1" ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  [[ "$prompt" == "-" ]] && prompt="$(cat)"
  local dir=""
  if [[ "$cmd" != list ]]; then
    [[ -n "${pos[0]:-}" ]] || die "usage: skiffcode $cmd <folder> …  (see: skiffcode --help)"
    [[ -d "${pos[0]}" ]] || die "not a folder: ${pos[0]}"
    dir="$(cd "${pos[0]}" && pwd -P)"
  fi
  start >&2
  SKIFFCODE_TOKEN="$(token)" CLI_CMD="$cmd" CLI_DIR="$dir" CLI_BRANCH="${pos[1]:-}" CLI_BASE="$base" CLI_NAME="$name" CLI_PROMPT="$prompt" \
  CLI_CLAUDE="$claude" CLI_SHOW="$show" CLI_JSON="$json" node -e '
    const e = process.env;
    const args = { dir: e.CLI_DIR || undefined, branch: e.CLI_BRANCH || undefined, base: e.CLI_BASE || undefined, name: e.CLI_NAME || undefined, prompt: e.CLI_PROMPT || undefined, claude: e.CLI_CLAUDE === "1", show: e.CLI_SHOW === "1" };
    fetch(`http://127.0.0.1:${process.argv[1]}/api/cli`, { method: "POST", headers: { "x-skiffcode-token": e.SKIFFCODE_TOKEN, "content-type": "application/json" }, body: JSON.stringify({ cmd: e.CLI_CMD, args }) })
      .then(r => r.json()).then(j => {
        if (!j.ok) { console.error("skiffcode: " + j.error); process.exit(1); }
        const r = j.result;
        if (e.CLI_JSON === "1") return console.log(JSON.stringify(r, null, 2));
        if (e.CLI_CMD === "list") {
          for (const repo of r) { console.log(`${repo.name}  ${repo.repo}`); for (const w of repo.worktrees) { console.log(`  ${w.branch || "(detached)"}  ${w.path}`); for (const s of w.sessions) console.log(`    ${s.kind === "claude" ? "claude" : "shell "}  ${s.name}  (${s.state})`); } }
          return;
        }
        if (r.created !== undefined) console.log(`Worktree  ${r.branch}  ${r.worktree}${r.created ? "  (created)" : "  (existing)"}`);
        if (r.session) console.log(`Claude    “${r.session.name}” started`);
        if (args.show) console.log(j.clients ? "Showing it in your SkiffCode window." : "Open SkiffCode to see it: skiffcode");
      }).catch(err => { console.error("skiffcode: " + err.message); process.exit(1); });
  ' "$PORT"
}
case "${1:-}" in
  new|claude|list) c="$1"; shift; cli "$c" "$@"; exit $? ;;
esac

app=1
case "${1:-}" in
  status) j="$(status_json 2>/dev/null || true)"; if [[ -n "$j" ]]; then echo "running — $j"; else echo "not running"; fi; exit 0 ;;
  stop) stop; exit 0 ;;
  restart) stop >/dev/null || true; start; echo "restarted"; exit 0 ;;
  logs) exec tail -n 200 -f "$LOG" ;;
  url) if [[ -n "${2:-}" && ! -d "$2" ]]; then die "not a folder: $2"; fi; start; url "${2:+$(cd "$2" && pwd -P)}"; echo; exit 0 ;;
  --tab) app=0; shift ;;
  --app) shift ;;
  -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

# Sortable by time. BSD date prints a literal N for %N: use seconds padded to nanosecond width.
stamp() {
  local n; n="$(date +%s%N)"
  case "$n" in *N) n="$(date +%s)000000000" ;; esac
  printf '%s' "$n"
}

dir=""
if [[ -n "${1:-}" ]]; then
  [[ -d "$1" ]] || die "not a folder: $1"
  dir="$(cd "$1" && pwd -P)"
fi
start
clients="$(status_json | grep -o '"clients":[0-9]*' | cut -d: -f2 || echo 0)"
if [[ -n "$dir" ]]; then
  printf '%s\n' "$dir" >"$SKIFFCODE_HOME/inbox/$(stamp)-$$.path"
fi
if [[ "${clients:-0}" -gt 0 ]]; then
  [[ -n "$dir" ]] && echo "SkiffCode: showing $dir in your open SkiffCode window." || echo "SkiffCode is already open."
else
  open_url "$(url "$dir")" "$app"
  echo "SkiffCode: $(url "$dir" | sed 's/tkn=[^&]*/tkn=…/')"
fi
